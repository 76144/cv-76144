// 1. MOTYW I PROJEKTY
document.getElementById('btn-theme')?.addEventListener('click', () => {
    const link = document.getElementById('theme-link');
    link.href = link.href.includes('green.css') ? 'red.css' : 'green.css';
});

document.getElementById('btn-toggle-projects')?.addEventListener('click', () => {
    const sec = document.getElementById('sekcja-projekty');
    sec.style.display = sec.style.display === 'none' ? 'block' : 'none';
});

// 2. WALIDACJA FORMULARZA
const form = document.getElementById('contactForm');

form?.addEventListener('submit', function(e) {
    e.preventDefault(); // Blokada wysyłania do backendu
    
    let isValid = true;
    const successMsg = document.getElementById('success-message');
    successMsg.style.display = 'none';

    // Pobranie wartości
    const data = {
        imie: document.getElementById('imie'),
        nazwisko: document.getElementById('nazwisko'),
        email: document.getElementById('email'),
        wiadomosc: document.getElementById('wiadomosc')
    };

    // Reset błędów
    Object.keys(data).forEach(key => {
        data[key].classList.remove('input-error');
        document.getElementById(`error-${key}`).textContent = '';
    });

    const showError = (key, msg) => {
        document.getElementById(`error-${key}`).textContent = msg;
        data[key].classList.add('input-error');
        isValid = false;
    };

    // WALIDACJA - WYMAGANE
    Object.keys(data).forEach(key => {
        if (!data[key].value.trim()) showError(key, 'To pole jest wymagane.');
    });

    // WALIDACJA - BRAK CYFR
    const regexCyfry = /\d/;
    if (data.imie.value && regexCyfry.test(data.imie.value)) showError('imie', 'Imię nie może zawierać cyfr.');
    if (data.nazwisko.value && regexCyfry.test(data.nazwisko.value)) showError('nazwisko', 'Nazwisko nie może zawierać cyfr.');

    // WALIDACJA - EMAIL
    const regexEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (data.email.value && !regexEmail.test(data.email.value)) {
        showError('email', 'Wpisz poprawny adres e-mail.');
    }

    // JEŚLI OK
    if (isValid) {
        successMsg.style.display = 'block';
        form.reset();
        window.scrollTo({ top: successMsg.offsetTop - 50, behavior: 'smooth' });
    }
});
