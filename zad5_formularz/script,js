// 1. ZMIANA MOTYWU
const btnTheme = document.getElementById('btn-theme');
const themeLink = document.getElementById('theme-link');

btnTheme?.addEventListener('click', () => {
    themeLink.setAttribute('href', themeLink.getAttribute('href') === 'red.css' ? 'green.css' : 'red.css');
});

// 2. POKAŻ/UKRYJ PROJEKTY
const btnToggle = document.getElementById('btn-toggle-projects');
const sectionProjects = document.getElementById('sekcja-projekty');

btnToggle?.addEventListener('click', () => {
    sectionProjects.style.display = sectionProjects.style.display === 'none' ? 'block' : 'none';
});

// 3. WALIDACJA FORMULARZA
const form = document.getElementById('contactForm');
const successMsg = document.getElementById('success-message');

form?.addEventListener('submit', function(e) {
    e.preventDefault();
    successMsg.style.display = 'none';
    
    let isValid = true;
    const fields = ['imie', 'nazwisko', 'email', 'wiadomosc'];
    
    // Resetowanie błędów
    fields.forEach(id => {
        const input = document.getElementById(id);
        const error = document.getElementById('error-' + id);
        input.classList.remove('input-error');
        if (error) error.textContent = '';
    });

    const values = {
        imie: document.getElementById('imie').value.trim(),
        nazwisko: document.getElementById('nazwisko').value.trim(),
        email: document.getElementById('email').value.trim(),
        wiadomosc: document.getElementById('wiadomosc').value.trim()
    };

    const showError = (id, msg) => {
        document.getElementById('error-' + id).textContent = msg;
        document.getElementById(id).classList.add('input-error');
        isValid = false;
    };

    // Walidacja puste pola
    fields.forEach(id => {
        if (!values[id]) showError(id, 'To pole jest wymagane.');
    });

    // Walidacja cyfry (Imię i Nazwisko)
    if (values.imie && /\d/.test(values.imie)) showError('imie', 'Imię nie może zawierać cyfr.');
    if (values.nazwisko && /\d/.test(values.nazwisko)) showError('nazwisko', 'Nazwisko nie może zawierać cyfr.');

    // Walidacja e-mail
    if (values.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(values.email)) {
        showError('email', 'Niepoprawny format adresu e-mail.');
    }

    if (isValid) {
        successMsg.style.display = 'block';
        form.reset();
        window.scrollTo({ top: successMsg.offsetTop - 50, behavior: 'smooth' });
    }
});
